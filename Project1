import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

stock_symbol = "AAPL"

data = yf.download(
    stock_symbol,
    start="2018-01-01",
    end="2026-01-01",
    auto_adjust=True
)

data = data[['Open', 'High', 'Low', 'Close', 'Volume']]
data.dropna(inplace=True)

data['MA_5'] = data['Close'].rolling(window=5).mean()
data['MA_20'] = data['Close'].rolling(window=20).mean()
data['Previous_Close'] = data['Close'].shift(1)

data.dropna(inplace=True)

X = data[['Open', 'High', 'Low', 'Volume',
          'MA_5', 'MA_20', 'Previous_Close']]

y = data['Close']

split = int(len(data) * 0.8)

X_train = X.iloc[:split]
X_test = X.iloc[split:]

y_train = y.iloc[:split]
y_test = y.iloc[split:]

# Step 6: Linear Regression
lr_model = LinearRegression()
lr_model.fit(X_train, y_train)

lr_predictions = lr_model.predict(X_test)

rf_model = RandomForestRegressor(
    n_estimators=100,
    random_state=42
)

rf_model.fit(X_train, y_train)

rf_predictions = rf_model.predict(X_test)

def evaluate_model(actual, predicted, name):
    mae = mean_absolute_error(actual, predicted)
    mse = mean_squared_error(actual, predicted)
    rmse = np.sqrt(mse)
    r2 = r2_score(actual, predicted)

    print("\n", name)
    print("MAE:", mae)
    print("MSE:", mse)
    print("RMSE:", rmse)
    print("R2 Score:", r2)

evaluate_model(y_test, lr_predictions, "Linear Regression")
evaluate_model(y_test, rf_predictions, "Random Forest")

plt.figure(figsize=(12, 6))

plt.plot(y_test.index, y_test.values,
         label="Actual Price")

plt.plot(y_test.index, rf_predictions,
         label="Random Forest Prediction")

plt.plot(y_test.index, lr_predictions,
         label="Linear Regression Prediction")

plt.xlabel("Date")
plt.ylabel("Stock Price")
plt.title("Stock Price Prediction")
plt.legend()
plt.grid()
plt.show()

latest_data = X.iloc[[-1]]

predicted_price = rf_model.predict(latest_data)[0]

print("\nPredicted price for the latest feature row:",
      predicted_price)
